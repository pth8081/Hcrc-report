PORT=4001

# Số lớp reverse proxy đứng TRƯỚC tiến trình này (Express "trust proxy") —
# BẮT BUỘC đúng khi triển khai sau Nginx, nếu không req.ip sẽ luôn là IP của
# Nginx cho MỌI request, làm hỏng ngầm giới hạn tần suất theo IP và cột
# IpAddress trong app.AuditLog. Mặc định 1 = 1 Nginx duy nhất đứng trước.
TRUST_PROXY_HOPS=1

# ===== CSDL ứng dụng HCRC_RP — Users, Roles, quyền, danh mục báo cáo, log,
#       danh mục, cấu hình email (rp-server có ghi vào đây) =====
RP_SERVER=localhost
RP_PORT=1433
RP_DATABASE=HCRC_RP
RP_USER=rp_app
RP_PASSWORD=
RP_ENCRYPT=true
RP_TRUST_CERT=false
# 20 (thay vì 10 mặc định cũ) — toàn bộ ứng dụng sắp nhận traffic công khai.
# Điểm khởi đầu hợp lý hơn, không phải con số cuối cùng — CHỈNH LẠI theo tải
# thật + giới hạn kết nối tối đa SQL Server/DBA cho phép (tổng các service
# cùng trỏ vào 1 SQL Server không được vượt giới hạn đó).
RP_POOL_MAX=20
RP_POOL_MIN=4

# ===== Data Warehouse — CHỈ ĐỌC, nguồn MẶC ĐỊNH cho báo cáo (khi
#       app.ReportCatalog.DataSourceId = NULL) =====
DWH_SERVER=localhost
DWH_PORT=1433
DWH_DATABASE=HCRC_DWH
DWH_USER=rpt_reader
DWH_PASSWORD=
DWH_ENCRYPT=true
DWH_TRUST_CERT=false
# Cùng lý do RP_POOL_MAX ở trên — đặc biệt quan trọng vì lọc theo field
# Dimensions chưa có index có thể khiến mỗi truy vấn giữ connection lâu hơn
# (xem dwh/schema.sql mục "Tối ưu lọc theo Dimensions").
DWH_POOL_MAX=20
DWH_POOL_MIN=4

# ===== Xác thực người dùng — tên biến RIÊNG cho từng service (RP_*), KHÔNG
#       dùng chung tên với etl/api-server dù cùng là "secret ký JWT phiên" —
#       tránh operator lỡ copy nhầm .env giữa 2 service làm token phiên dùng
#       chéo được (đã có iss/aud chặn thêm ở tầng code, nhưng secret vẫn
#       PHẢI random riêng) =====
RP_JWT_SECRET=doi-chuoi-nay-thanh-gia-tri-ngau-nhien-dai-cho-rp
COOKIE_SECURE=false

# Mã hoá mật khẩu lưu trong CSDL (app.ReportDataSources, app.EmailSettings) —
# base64 của đúng 32 byte. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Sau khi chạy app/schema.sql, tạo tài khoản quản trị đầu tiên bằng:
#   npm run seed:admin -- <username> <password> "<Họ tên>"

# Cache kết quả POST /api/reports/:id/run (KHÔNG áp cho /export hay lịch gửi
# email) theo mili-giây — 0 = tắt hẳn. Mặc định 30000 (30 giây) nếu để
# trống. Xem lib/reportResultCache.js.
REPORT_CACHE_TTL_MS=30000

# Giữ app.AuditLog (nhật ký thao tác admin + lịch sử gửi email tự động) bao
# nhiêu ngày trước khi job dọn tự xoá (jobs/cleanupAuditLog.js).
AUDIT_LOG_RETENTION_DAYS=90
CLEANUP_CRON=0 2 * * *
