PORT=4002
RATE_LIMIT_PER_MINUTE=120

# Số lớp reverse proxy đứng TRƯỚC tiến trình này (Express "trust proxy") —
# BẮT BUỘC đúng khi triển khai sau Nginx, nếu không req.ip sẽ luôn là IP của
# Nginx cho MỌI request, làm hỏng ngầm: giới hạn IP riêng từng đối tác, danh
# sách IP admin (ADMIN_ALLOWED_IPS), giới hạn tần suất theo IP, và cột
# IpAddress trong api.RequestLog. Mặc định 1 = đúng mô hình "1 Nginx duy nhất
# đứng trước, cả 3 hệ thống trên cùng 1 máy chủ" — đổi nếu triển khai qua
# nhiều lớp proxy/CDN hơn.
TRUST_PROXY_HOPS=1

# ===== Data Warehouse — dùng cho /api/v1/reports (báo cáo tổng hợp, không
#       realtime). Vẫn tĩnh qua .env, giống rp-server — đây là nguồn
#       MẶC ĐỊNH dùng chung, không cần cấu hình động =====
DWH_SERVER=localhost
DWH_PORT=1433
DWH_DATABASE=HCRC_DWH
DWH_USER=rpt_reader
DWH_PASSWORD=
DWH_ENCRYPT=true
DWH_TRUST_CERT=false
# 10 (từ 20 trước khi chạy PM2 cluster mode) — mỗi WORKER PM2 tự mở pool
# RIÊNG (không dùng chung), tổng kết nối CSDL thật = instances × pool.max —
# xem deploy/ecosystem.config.js. Mặc định instances=2 cho api-server, nên
# 10×2=20, GIỮ NGUYÊN đúng ngân sách kết nối đã tính trước khi có cluster
# (đủ tránh nút cổ chai khi vài chục request đồng thời, đặc biệt nếu lọc
# theo field Dimensions chưa có index — xem dwh/schema.sql mục "Tối ưu lọc
# theo Dimensions"). Đổi instances trong ecosystem.config.js PHẢI đổi lại số
# này tương ứng (10 × instances = ngân sách mong muốn) — CHỈNH LẠI theo tải
# thật + giới hạn kết nối tối đa mà SQL Server/DBA cho phép (tổng MỌI
# service cùng trỏ vào 1 SQL Server không được vượt giới hạn đó).
DWH_POOL_MAX=10
DWH_POOL_MIN=4

# ===== HCRC_API — đối tác gọi API (api.ApiConsumers), tài khoản quản trị
#       (admin.AdminUsers), nhật ký request (api.RequestLog), nguồn dữ liệu
#       cho các endpoint realtime (api.DataSources, api.RealtimeEndpointDefs).
#       API Server CÓ GHI vào CSDL này (khác DWH — chỉ đọc) =====
ADMIN_SERVER=localhost
ADMIN_PORT=1433
ADMIN_DATABASE=HCRC_API
ADMIN_USER=api_admin
ADMIN_PASSWORD=
ADMIN_ENCRYPT=true
ADMIN_TRUST_CERT=false
# 10 — cùng lý do DWH_POOL_MAX ở trên (chia đôi cho instances=2 mặc định),
# CSDL này còn phục vụ cả xác thực đối tác (mỗi request /api/v1/* đều có
# thể chạm tới, dù đã cache — xem lib/apiConsumers.js), chống phát lại HMAC
# (admin.HmacUsedSignatures — xem lib/hmacAuth.js) lẫn trang quản trị.
ADMIN_POOL_MAX=10
ADMIN_POOL_MIN=4

# ===== Xác thực trang quản trị (api-admin/) — tên biến RIÊNG cho từng
#       service (API_ADMIN_*), KHÔNG dùng chung tên với etl/rp-server dù
#       cùng là "secret ký JWT phiên admin" — tránh operator lỡ copy nhầm
#       .env giữa 2 service làm token phiên dùng chéo được (đã có iss/aud
#       chặn thêm ở tầng code, nhưng secret vẫn PHẢI random riêng) =====
API_ADMIN_JWT_SECRET=doi-chuoi-nay-thanh-gia-tri-ngau-nhien-dai-cho-api-admin
ADMIN_COOKIE_SECURE=false
# CHỈ đặt =true nếu triển khai "PM2-only" (deploy/Hướng dẫn triển khai
# PM2.md — KHÔNG Nginx/TLS ở đâu cả, chỉ http://) — NODE_ENV=production vẫn
# ép cookie phiên "Secure" (ecosystem.config.js đặt vậy cho mọi topology),
# trình duyệt sẽ TỪ CHỐI lưu cookie đó trên kết nối http:// thường, đăng
# nhập không giữ được phiên. ĐỂ TRỐNG (mặc định) nếu có Nginx/TLS thật phía
# trước — xem chú thích đầy đủ tại lib/adminAuth.js:setSessionCookie().
# ADMIN_COOKIE_FORCE_INSECURE=true

# Mã hoá mật khẩu các nguồn lưu trong api.DataSources, và HmacSecret trong
# api.ApiConsumers (AuthMethod='hmac') — base64 của đúng 32 byte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_ENCRYPTION_KEY=

# TUỲ CHỌN — chỉ đặt khi đang XOAY KHOÁ (đổi API_ENCRYPTION_KEY sang giá trị
# mới): gán giá trị CŨ của API_ENCRYPTION_KEY vào đây TRƯỚC khi đổi, để dữ
# liệu mã hoá bằng khoá cũ vẫn giải mã được trong lúc chuyển tiếp — xem chú
# thích trong lib/crypto.js. Để trống khi không xoay khoá (mặc định).
API_ENCRYPTION_KEY_PREVIOUS=

# ===== OAuth2 Client Credentials cho đối tác AuthMethod='oauth2'
#       (POST /api/v1/oauth/token) — access token là JWT ký bằng khoá này,
#       RIÊNG, khác API_ADMIN_JWT_SECRET (đó cho api-admin/, ranh giới khác) =====
OAUTH_JWT_SECRET=doi-chuoi-nay-thanh-gia-tri-ngau-nhien-dai-cho-oauth
OAUTH_TOKEN_TTL_SECONDS=3600

# Danh sách IP được phép gọi /admin/* — lớp phòng thủ BỔ SUNG, kiểm soát
# chính vẫn là không proxy /admin ra Internet ở Nginx (xem README). Để trống
# = không chặn gì thêm ở tầng ứng dụng.
ADMIN_ALLOWED_IPS=

# Giữ api.RequestLog bao nhiêu ngày trước khi job dọn tự xoá (jobs/cleanupRequestLog.js).
REQUEST_LOG_RETENTION_DAYS=90
# Giữ admin.AuditLog (nhật ký thao tác admin) bao nhiêu ngày trước khi job dọn
# tự xoá (jobs/cleanupAuditLog.js).
AUDIT_LOG_RETENTION_DAYS=90
CLEANUP_CRON=0 2 * * *

# Sau khi chạy api-db/schema.sql, tạo tài khoản quản trị đầu tiên bằng:
#   npm run seed:admin -- <username> <password> "<Họ tên>" admin
#
# LƯU Ý: Endpoint realtime (/api/v1/realtime/{endpoint}/...) KHÔNG còn viết
# cứng trong code hay đọc .env — admin tự tạo qua trang quản trị "Endpoint
# realtime" (chọn nguồn ở "Nguồn dữ liệu" rồi duyệt bảng/cột thật, không gõ
# tay — api.DataSources + api.RealtimeEndpointDefs).

# Cache kết quả GET /api/v1/reports/:id/run theo mili-giây — 0 = tắt hẳn.
# Mặc định 30000 (30 giây) nếu để trống. Xem lib/reportResultCache.js.
REPORT_CACHE_TTL_MS=30000

# ===== /internal/* — API NỘI BỘ để rp-server gọi SANG (bản 8.70, theo yêu
#       cầu người dùng) — KHÔNG dành cho đối tác ngoài, KHÔNG bắt buộc phải
#       cấu hình (chỉ cần nếu triển khai "Upload cảnh báo hàng tồn từ báo
#       cáo", xem rp-server/.env.example). Thiếu cấu hình bên dưới chỉ làm
#       route /internal/* trả lỗi rõ ràng khi bị gọi, KHÔNG làm sập cả
#       api-server. =====

# Pool "ETL_DB" — kết nối THẲNG sang CSDL ETL (HCRC_ETL) để ghi bảng
# etl.StockAlertThresholds — DÙNG LẠI Y NGUYÊN giá trị ADMIN_* đã có sẵn
# trong etl/.env (tài khoản etl_admin — ĐÃ có quyền ghi bảng này vì chính
# etl app cũng dùng tài khoản đó), KHÔNG tạo tài khoản SQL Server mới.
ETL_DB_SERVER=localhost
ETL_DB_PORT=1433
ETL_DB_DATABASE=HCRC_ETL
ETL_DB_USER=etl_admin
ETL_DB_PASSWORD=
ETL_DB_ENCRYPT=true
ETL_DB_TRUST_CERT=false
ETL_DB_POOL_MAX=5
ETL_DB_POOL_MIN=0

# Secret CỐ ĐỊNH dùng chung giữa rp-server và api-server — PHẢI khớp y hệt
# giá trị INTERNAL_API_SECRET trong rp-server/.env. Đổi thành chuỗi ngẫu
# nhiên dài khi triển khai thật (KHÔNG để trống — thiếu secret này route
# /internal/* luôn trả lỗi 500, không bao giờ cho qua "quên xác thực").
INTERNAL_API_SECRET=

# Danh sách IP được phép gọi /internal/* — lớp phòng thủ BỔ SUNG (giống
# ADMIN_ALLOWED_IPS ở trên), kiểm soát CHÍNH vẫn là không proxy /internal ra
# Internet ở Nginx — chỉ máy chủ rp-server trong mạng nội bộ gọi tới được.
# Để trống = không chặn gì thêm ở tầng ứng dụng (chỉ còn lớp secret ở trên).
INTERNAL_ALLOWED_IPS=

# CORS cho /api/v1/* — TẮT MẶC ĐỊNH (để trống = không set header CORS, giữ
# nguyên hành vi hiện tại). Đa số đối tác gọi API server-to-server (không có
# Origin header, CORS không liên quan) nên KHÔNG cần đặt biến này. Chỉ khai
# khi một đối tác thật sự chạy JS trên trình duyệt (domain của họ) gọi thẳng
# /api/v1/* — liệt kê CHÍNH XÁC từng origin được phép, phân cách dấu phẩy,
# không dùng "*" (API key/HMAC/OAuth token không nên lộ cho mọi origin bất
# kỳ). Xem lib/corsAllowlist.js.
# Ví dụ: CORS_ALLOWED_ORIGINS=https://doitac-a.com,https://app.doitac-b.vn
CORS_ALLOWED_ORIGINS=

# ===== Voucher — kết nối DSMART16 (Live) cho API check/redeem voucher
#       (POST /api/v1/vouchers/check, /redeem — xem
#       api-voucher-check-redeem.md). CHỈ dùng bởi
#       scripts/seedVoucherDataSource.js (npm run seed:voucher-datasource)
#       — script này TỰ tạo/cập nhật đúng 1 dòng api.DataSources rồi trỏ
#       api.VoucherSettings vào dòng đó, THAY THẾ việc vào api-admin tự tay
#       thêm "Nguồn dữ liệu" + chọn ở trang "Cấu hình Voucher". Điền xong,
#       chạy lệnh trên — KHÔNG cần đăng nhập api-admin bằng trình duyệt.
#       Đổi mật khẩu/server DSMART16 sau này: sửa lại đúng các biến này rồi
#       chạy lại lệnh trên — CẬP NHẬT tại chỗ, không tạo trùng dòng. Các
#       biến này CHỈ dùng lúc chạy script (không dùng lúc server phục vụ
#       request thật — server luôn đọc từ CSDL api.DataSources/
#       api.VoucherSettings, không đọc thẳng .env), nên để trống bình
#       thường sau khi đã chạy script xong 1 lần, không cần giữ mãi. =====
VOUCHER_DSMART16_NAME=DSMART16 (Live) - Voucher
VOUCHER_DSMART16_SERVER=
VOUCHER_DSMART16_PORT=1433
VOUCHER_DSMART16_DATABASE=DSMART16
VOUCHER_DSMART16_USER=
VOUCHER_DSMART16_PASSWORD=
VOUCHER_DSMART16_ENCRYPT=true
VOUCHER_DSMART16_TRUST_CERT=false

# ===== scripts/seedVoucherCheckConsumer.js (bản 9.03, theo yêu cầu người
#       dùng) — tạo "Đối tác" cho rp-server gọi Endpoint realtime
#       voucher-check mà KHÔNG cần cấu hình tay qua api-admin. TUỲ CHỌN —
#       để trống dùng mặc định. =====
# Tên đối tác — đổi nếu muốn đặt tên khác "rp-server (voucher-check)".
VOUCHER_CONSUMER_NAME=
# "true" để LUÂN CHUYỂN (sinh API key MỚI, key CŨ hết tác dụng ngay) nếu
# đối tác đã tồn tại — để trống/"false" (mặc định) thì script bỏ qua, không
# đổi key của đối tác đã có.
VOUCHER_CONSUMER_ROTATE=

# ===== Đăng nhập vân tay/Face ID cho api-admin (WebAuthn, bản 8.78, theo
#       yêu cầu người dùng — mirror rp-server/.env.example) =====
# BẮT BUỘC khai ĐÚNG domain THẬT đang phục vụ api-admin cho trình duyệt —
# WebAuthn gắn chặt vào origin trình duyệt thấy lúc đăng ký/đăng nhập, sai
# domain thì LUÔN báo lỗi "invalid rpID"/origin mismatch (không phải lỗi
# code, xem routes/admin/webauthn.js). Để trống 1 trong 2 biến dưới = tắt
# hẳn tính năng này (API trả lỗi rõ ràng, không crash server).
#
# WEBAUTHN_RP_ID   — CHỈ phần domain (không http://, không port) — vd nếu
#                     api-admin chạy ở https://api.hcrc.vidu.vn thì giá trị
#                     ĐÚNG là "api.hcrc.vidu.vn".
# WEBAUTHN_RP_ORIGIN — ĐẦY ĐỦ origin (có scheme) — vd
#                     "https://api.hcrc.vidu.vn". PHẢI cùng domain với
#                     WEBAUTHN_RP_ID ở trên, khác cổng/scheme vẫn tính là
#                     origin khác.
WEBAUTHN_RP_NAME=HCRC API
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGIN=
