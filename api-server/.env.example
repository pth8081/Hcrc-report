PORT=4002
RATE_LIMIT_PER_MINUTE=120

# ===== Data Warehouse — dùng cho /api/v1/reports (báo cáo tổng hợp, không realtime) =====
DWH_SERVER=localhost
DWH_PORT=1433
DWH_DATABASE=HCRC_DWH
DWH_USER=rpt_reader
DWH_PASSWORD=
DWH_ENCRYPT=true
DWH_TRUST_CERT=false
DWH_POOL_MAX=10
DWH_POOL_MIN=2

# ===== OLTP — pool RIÊNG, nhỏ, chỉ dùng cho /api/v1/inventory|loyalty|vouchers =====
# Đọc thẳng qua view (schema api_rt) trên chính CSDL OLTP — KHÔNG qua Data
# Warehouse, vì tồn kho/điểm thẻ/voucher cần đúng thời điểm thật, không chấp
# nhận được độ trễ của ETL theo lịch.
OLTP_SERVER=
OLTP_PORT=1433
OLTP_DATABASE=
OLTP_USER=api_rt_reader
OLTP_PASSWORD=
OLTP_ENCRYPT=true
OLTP_TRUST_CERT=false
OLTP_POOL_MAX=5
OLTP_POOL_MIN=0

# ===== API key cấp cho từng hệ thống đối tác (TẠM THỜI qua .env — xem lib/apiKeys.js) =====
# JSON array: [{"key":"...","name":"HeThongDoiTacA","scopes":["reports","realtime"]}]
API_KEYS_JSON=
