PORT=4001

# ===== Data Warehouse (chỉ đọc — Report Server không bao giờ ghi vào kho) =====
DWH_SERVER=localhost
DWH_PORT=1433
DWH_DATABASE=HCRC_DWH
DWH_USER=rpt_reader
DWH_PASSWORD=
DWH_ENCRYPT=true
DWH_TRUST_CERT=false
DWH_POOL_MAX=10
DWH_POOL_MIN=2

# ===== Xác thực người dùng nội bộ =====
# TẠM THỜI: một tài khoản quản trị cấu hình qua .env — thay bằng bảng người
# dùng riêng hoặc tích hợp AD/SSO khi đã chốt (xem tài liệu kiến trúc, mục 10).
# Tạo ADMIN_PASSWORD_HASH bằng: node -e "console.log(require('bcryptjs').hashSync('mat-khau-that', 10))"
JWT_SECRET=doi-chuoi-nay-thanh-gia-tri-ngau-nhien-dai
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=false
