PORT=4001

# ===== CSDL ứng dụng HCRC_RP — Users, Roles, quyền, danh mục báo cáo, log,
#       danh mục, cấu hình email (report-server có ghi vào đây) =====
RP_SERVER=localhost
RP_PORT=1433
RP_DATABASE=HCRC_RP
RP_USER=rp_app
RP_PASSWORD=
RP_ENCRYPT=true
RP_TRUST_CERT=false
RP_POOL_MAX=10
RP_POOL_MIN=2

# ===== Data Warehouse — CHỈ ĐỌC, nguồn MẶC ĐỊNH cho báo cáo (khi
#       app.ReportCatalog.DataSourceId = NULL) =====
DWH_SERVER=localhost
DWH_PORT=1433
DWH_DATABASE=HCRC_DWH
DWH_USER=rpt_reader
DWH_PASSWORD=
DWH_ENCRYPT=true
DWH_TRUST_CERT=false
DWH_POOL_MAX=10
DWH_POOL_MIN=2

# ===== Xác thực người dùng =====
JWT_SECRET=doi-chuoi-nay-thanh-gia-tri-ngau-nhien-dai
COOKIE_SECURE=false

# Mã hoá mật khẩu lưu trong CSDL (app.ReportDataSources, app.EmailSettings) —
# base64 của đúng 32 byte. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Sau khi chạy app/schema.sql, tạo tài khoản quản trị đầu tiên bằng:
#   npm run seed:admin -- <username> <password> "<Họ tên>"
