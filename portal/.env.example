# URL thật của các ứng dụng đã triển khai — portal chỉ điều hướng sang đây,
# không đụng gì tới xác thực/cookie của từng ứng dụng. Thêm ứng dụng mới:
# thêm 1 biến VITE_*_URL ở đây, khớp đúng "envVar" khai trong src/apps.js.
VITE_REPORT_URL=http://localhost:5173
VITE_API_ADMIN_URL=http://localhost:5174
VITE_ETL_ADMIN_URL=http://localhost:5175
