# ===== Data Warehouse (đích ghi dữ liệu) =====
DWH_SERVER=localhost
DWH_PORT=1433
DWH_DATABASE=HCRC_DWH
DWH_USER=etl_writer
DWH_PASSWORD=
DWH_ENCRYPT=true
DWH_TRUST_CERT=false
DWH_POOL_MAX=5

# ===== Cảnh báo lỗi qua email khi một lượt đồng bộ thất bại (tuỳ chọn) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# ===== Lịch chạy mặc định (cú pháp cron) — có thể ghi đè riêng từng nguồn
#       bằng biến <SRC_..._CRON> tương ứng =====
SYNC_CRON=*/15 * * * *

# ===== Từng nguồn: copy khối dưới, đổi SRC_VIDU thành đúng envPrefix khai báo
#       trong sources/<ten-nguon>.js (xem sources/_template.js) =====
# SRC_VIDU_SERVER=
# SRC_VIDU_PORT=1433
# SRC_VIDU_DATABASE=
# SRC_VIDU_USER=
# SRC_VIDU_PASSWORD=
# SRC_VIDU_ENCRYPT=true
# SRC_VIDU_TRUST_CERT=false
# SRC_VIDU_POOL_MAX=5
# SRC_VIDU_CRON=*/15 * * * *
