PORT=4003

# Số lớp reverse proxy đứng TRƯỚC tiến trình này (Express "trust proxy") —
# chỉ cần đúng nếu /admin/* của ETL cũng được Nginx proxy (không khuyến
# khích — xem README). Mặc định 1 = 1 Nginx duy nhất đứng trước.
TRUST_PROXY_HOPS=1

# Giữ etl.SyncLog (log chạy job) và admin.AuditLog (nhật ký thao tác admin)
# bao nhiêu ngày trước khi job dọn tự xoá (jobs/cleanupLogs.js).
SYNC_LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=90
CLEANUP_CRON=0 2 * * *

# ===== Data Warehouse (đích ghi dữ liệu — chỉ dwh.ReportFacts) =====
DWH_SERVER=localhost
DWH_PORT=1433
DWH_DATABASE=HCRC_DWH
DWH_USER=etl_writer
DWH_PASSWORD=
DWH_ENCRYPT=true
DWH_TRUST_CERT=false
DWH_POOL_MAX=5

# ===== Pool RIÊNG, HẸP HƠN DWH_* ở trên — CHỈ dùng cho trang "Nhập chỉ
#       tiêu" (routes/admin/salesTargets.js), KHÔNG dùng cho bất kỳ route
#       nào khác của etl. Cùng máy chủ/CSDL với DWH_* (server/port/database
#       giống hệt), CHỈ KHÁC tài khoản — dwh_target_importer (xem
#       dwh/grants.sql) chỉ có quyền trên đúng 1 bảng dwh.SalesTargets, dù
#       route này chạy trong CÙNG tiến trình etl vẫn không dùng chung
#       DWH_USER (etl_writer, quyền rộng hơn nhiều) — phòng thủ chiều sâu:
#       lỗi ở route nhập chỉ tiêu không thể chạm được dwh.ReportFacts. =====
DWH_TARGET_IMPORTER_SERVER=localhost
DWH_TARGET_IMPORTER_PORT=1433
DWH_TARGET_IMPORTER_DATABASE=HCRC_DWH
DWH_TARGET_IMPORTER_USER=dwh_target_importer
DWH_TARGET_IMPORTER_PASSWORD=
DWH_TARGET_IMPORTER_ENCRYPT=true
DWH_TARGET_IMPORTER_TRUST_CERT=false
DWH_TARGET_IMPORTER_POOL_MAX=3

# ===== CSDL quản trị ETL — HCRC_ETL: nguồn dữ liệu (etl.DataSources), cấu
#       hình đồng bộ (etl.SyncJobs), trạng thái/log, tài khoản quản trị
#       (etl-admin/). ETL CÓ GHI vào CSDL này (khác DWH — chỉ ghi facts). =====
ADMIN_SERVER=localhost
ADMIN_PORT=1433
ADMIN_DATABASE=HCRC_ETL
ADMIN_USER=etl_admin
ADMIN_PASSWORD=
ADMIN_ENCRYPT=true
ADMIN_TRUST_CERT=false
# 5 (từ 10 trước khi chạy PM2 cluster mode) — mỗi WORKER PM2 tự mở pool
# RIÊNG, tổng kết nối CSDL thật = instances × pool.max (mặc định instances=2
# cho etl, xem deploy/ecosystem.config.js) -> 5×2=10, GIỮ NGUYÊN ngân sách
# cũ. Dùng cho CRUD trang quản trị (mọi worker phục vụ ngang nhau) — KHÔNG
# đụng DWH_POOL_MAX/DWH_TARGET_IMPORTER_POOL_MAX bên trên: việc GHI dwh
# (chạy đồng bộ lịch/tay) chỉ thật sự chạy theo lịch trên worker leader
# (xem lib/clusterLeader.js, jobs/scheduler.js) nhưng "Chạy thử" (bấm tay từ
# route) có thể rơi vào BẤT KỲ worker nào — giữ đủ dung lượng gốc cho
# trường hợp đó, đã có sp_getapplock (jobs/runSync.js) chặn ghi chồng lấn
# CẤP CSDL, không phụ thuộc worker nào gọi.
ADMIN_POOL_MAX=5
ADMIN_POOL_MIN=2

# ===== Xác thực trang quản trị (etl-admin/) — tên biến RIÊNG cho từng
#       service (ETL_*), KHÔNG dùng chung tên với api-server/rp-server dù
#       cùng là "secret ký JWT phiên admin" — tránh operator lỡ copy nhầm
#       .env giữa 2 service làm token phiên dùng chéo được (đã có iss/aud
#       chặn thêm ở tầng code, nhưng secret vẫn PHẢI random riêng) =====
ETL_ADMIN_JWT_SECRET=doi-chuoi-nay-thanh-gia-tri-ngau-nhien-dai-cho-etl
ADMIN_COOKIE_SECURE=false

# Danh sách IP được phép gọi /admin/* — lớp phòng thủ BỔ SUNG, kiểm soát
# chính vẫn phải là KHÔNG proxy /admin ra Internet ở Nginx/tường lửa (etl là
# dịch vụ rủi ro cao nhất trong 3 hệ thống nếu bị xâm nhập — nắm giữ mật
# khẩu của TOÀN BỘ nguồn dữ liệu đã cấu hình). Để trống = không chặn gì
# thêm ở tầng ứng dụng.
ETL_ADMIN_ALLOWED_IPS=

# Mã hoá mật khẩu các nguồn lưu trong etl.DataSources — base64 của đúng 32 byte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ETL_ENCRYPTION_KEY=

# TUỲ CHỌN — chỉ đặt khi đang XOAY KHOÁ (đổi ETL_ENCRYPTION_KEY sang giá trị
# mới): gán giá trị CŨ của ETL_ENCRYPTION_KEY vào đây TRƯỚC khi đổi, để dữ
# liệu mã hoá bằng khoá cũ vẫn giải mã được trong lúc chuyển tiếp — xem chú
# thích trong lib/crypto.js. Để trống khi không xoay khoá (mặc định).
ETL_ENCRYPTION_KEY_PREVIOUS=

# ===== Cảnh báo lỗi qua email khi một lượt đồng bộ thất bại (tuỳ chọn) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# ===== CHỈ dùng cho job Type="custom" (connector viết tay trong sources/,
#       xem sources/_template.js) — job Type="table" KHÔNG cần gì ở đây, cấu
#       hình hoàn toàn qua etl-admin/ (etl.DataSources). Copy khối dưới, đổi
#       SRC_VIDU thành đúng envPrefix khai báo trong connector =====
# SRC_VIDU_SERVER=
# SRC_VIDU_PORT=1433
# SRC_VIDU_DATABASE=
# SRC_VIDU_USER=
# SRC_VIDU_PASSWORD=
# SRC_VIDU_ENCRYPT=true
# SRC_VIDU_TRUST_CERT=false

# Sau khi chạy etl-db/schema.sql, tạo tài khoản quản trị đầu tiên bằng:
#   npm run seed:admin -- <username> <password> "<Họ tên>" admin
